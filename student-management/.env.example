# Generate a fresh key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=60

AUTH_SERVICE_URL=http://127.0.0.1:8001
STUDENT_SERVICE_URL=http://127.0.0.1:8002
COURSE_SERVICE_URL=http://127.0.0.1:8003
FRONTEND_ORIGIN=http://localhost:5173

